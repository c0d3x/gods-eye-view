{
  "name": "gods-eye-view",
  "private": true,
  "version": "0.2.0",
  "description": "A real-time intelligence console for planet Earth — photorealistic 3D globe, live aircraft/ships/satellites/earthquakes/CCTV, and hands-free voice control. Runs in a browser.",
  "type": "module",
  "license": "MIT",
  "author": "Bilawal Sidhu",
  "homepage": "https://github.com/c0d3x/gods-eye-view#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/c0d3x/gods-eye-view.git"
  },
  "bugs": {
    "url": "https://github.com/c0d3x/gods-eye-view/issues"
  },
  "engines": {
    "node": ">=24.14.0 <25 || >=26 <27"
  },
  "packageManager": "pnpm@11.26.0",
  "keywords": [
    "cesium",
    "3d-globe",
    "geospatial",
    "osint",
    "spatial-intelligence",
    "photorealistic-3d-tiles",
    "adsb",
    "ais",
    "satellites",
    "voice-control",
    "openai-realtime",
    "visualization"
  ],
  "scripts": {
    "doctor": "node scripts/setup-doctor.mjs",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome check --formatter-enabled=false --error-on-warnings",
    "dev": "vite",
    "dev:secure": "./scripts/dev-secure.sh",
    "opensky:import": "./scripts/opensky-import-client.sh",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/run-unit-tests.mjs",
    "test:allocations": "node scripts/run-unit-tests.mjs --allocations-only",
    "test:coverage": "node scripts/run-unit-tests.mjs --skip-allocations --coverage && node scripts/coverage-summary.mjs",
    "test:track": "node scripts/track-regression.mjs",
    "qa:setup": "node scripts/qa-setup.mjs",
    "qa:map-source-tray": "node scripts/qa-map-source-tray.mjs",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "typecheck": "tsc --noEmit -p jsconfig.json && tsc --noEmit -p server/jsconfig.json",
    "knip": "knip"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "cesium": "^1.145.0",
    "mgrs": "^2.2.0",
    "pbf": "^5.1.2",
    "satellite.js": "^7.1.0",
    "vite": "^8.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "24.13.4",
    "knip": "6.35.1",
    "lefthook": "^2.1.12",
    "puppeteer": "^25.10.0",
    "sharp": "^0.35.4",
    "typescript": "7.0.2"
  },
  "exports": {
    "./infrastructure": "./src/data/infrastructure.js",
    "./infrastructure/geojson": "./src/data/localGeojsonCore.js",
    "./infrastructure/lod": "./src/data/localGeojsonLod.js",
    "./application": "./src/app/application.js",
    "./application/viewer": "./src/app/viewer.js"
  }
}
