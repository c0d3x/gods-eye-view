{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "*.js",
      "*.mjs",
      "*.json",
      "config/**/*.json",
      "pinokio/**/*.js",
      "pinokio/**/*.mjs",
      "pinokio/**/*.json",
      "scripts/**/*.js",
      "scripts/**/*.mjs",
      "scripts/**/*.json",
      "server/**/*.js",
      "server/**/*.mjs",
      "src/**/*.js",
      "src/**/*.mjs",
      "tools/**/*.js",
      "tools/**/*.mjs"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
