      "scripts/check-package-boundaries.mjs",
      "scripts/cesium-vite-plugin.mjs",
      "src/tooling/format.test.mjs",
      "src/tooling/packageBoundaries.test.mjs",
      "src/tooling/packageManager.test.mjs",
      "src/tooling/cesiumVitePlugin.test.mjs",
      "src/data/infrastructure.js",
      "src/data/infrastructure.test.mjs",
      "src/data/localGeojsonCore.js",
      "src/data/localGeojsonLod.js",
      "src/main.js",
      "scripts/qa-application.mjs",
      "src/app/application.js",
      "src/app/application.test.mjs",
      "src/app/mapLifecycle.test.mjs",
      "src/app/startupCamera.test.mjs",
      "src/app/viewer.js",
      "src/editions/local/application.js",
      "src/editions/local/controls.js",
      "src/editions/local/data.js",
      "src/editions/local/errors.js",
      "src/editions/local/scene.js",
      "src/editions/local/startupChrome.js",
